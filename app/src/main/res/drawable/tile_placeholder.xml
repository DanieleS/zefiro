<?xml version="1.0" encoding="utf-8"?>
<!--
    The title card a game tile shows when it has no cover of its own, or none yet: a raised
    surface with a hairline edge, so a row of them still reads as a row of tiles on the black
    ground rather than as loose text. Colours from the approved See all mock's fallback cell.

    Rounded like the art it stands in for, at tile_corner (10dp) rather than the mock's 7: the
    art's TileShape and the focus ring share that radius, and a card rounder or squarer than
    the covers beside it, or than its own ring, would show at every corner.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/tile_corner" />
    <solid android:color="@color/tile_placeholder" />
    <stroke
        android:width="1dp"
        android:color="@color/tile_placeholder_outline" />
</shape>
