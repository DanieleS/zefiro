<?xml version="1.0" encoding="utf-8"?>
<!--
    The Search section's text field: a raised surface with a hairline edge at rest, and the
    signal ring on focus, the same 2dp ring as a tile's, since the d-pad reaches the field the
    way it reaches a tile and has to see it land.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="120">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/search_field_corner" />
            <solid android:color="@color/surface_container" />
            <stroke
                android:width="@dimen/tile_focus_stroke"
                android:color="@color/signal" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/search_field_corner" />
            <solid android:color="@color/surface_container" />
            <stroke
                android:width="1dp"
                android:color="@color/outline_variant" />
        </shape>
    </item>

</selector>
