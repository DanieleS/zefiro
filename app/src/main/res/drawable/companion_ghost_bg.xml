<?xml version="1.0" encoding="utf-8"?>
<!--
    The companion panel's quiet pill (Quit game), after Widget.Zefiro.GhostButton: a faint
    fill that reads over any backdrop. Pressed, it fills with the signal wash and rings.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="120">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/primary_button_corner" />
            <solid android:color="@color/signal_wash" />
            <stroke
                android:width="@dimen/tile_focus_stroke"
                android:color="@color/signal" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/primary_button_corner" />
            <solid android:color="@color/ghost_fill" />
        </shape>
    </item>

</selector>
