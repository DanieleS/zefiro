<?xml version="1.0" encoding="utf-8"?>
<!--
    The tile that ends the All games shelf and leads to the grid. It wears the no-cover title
    card's surface, so it reads as one more tile in the row (the d-pad's way to See all), and
    the tile's focus ring is laid over it as on any game.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/tile_corner" />
    <solid android:color="@color/surface_container" />
    <stroke
        android:width="1dp"
        android:color="@color/tile_placeholder_outline" />
</shape>
