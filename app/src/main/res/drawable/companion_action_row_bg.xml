<?xml version="1.0" encoding="utf-8"?>
<!--
    A game's action on the companion panel: the mocks' .mini, a card fill one step above the
    true-black ground. The d-pad's place (state_activated, the panel's virtual focus) wears the
    same 2dp signal ring as every other stop (@drawable/stop_bg); a press fills it with the wash.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="120">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/stop_corner" />
            <solid android:color="@color/signal_wash" />
            <stroke
                android:width="@dimen/tile_focus_stroke"
                android:color="@color/signal" />
        </shape>
    </item>

    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/stop_corner" />
            <solid android:color="@color/surface" />
            <stroke
                android:width="@dimen/tile_focus_stroke"
                android:color="@color/signal" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/stop_corner" />
            <solid android:color="@color/surface_container_low" />
        </shape>
    </item>

</selector>
