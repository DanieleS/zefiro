<?xml version="1.0" encoding="utf-8"?>
<!--
    A menu row that destroys something (Delete PC). The same grammar as @drawable/menu_row_bg,
    in the danger tone: focused or activated, a danger ring on the danger container; pressed,
    the same, so the row never flashes the signal colour on its way to a confirmation.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="120">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/menu_row_corner" />
            <solid android:color="@color/danger_container" />
            <stroke
                android:width="@dimen/tile_focus_stroke"
                android:color="@color/danger" />
        </shape>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/menu_row_corner" />
            <solid android:color="@color/danger_container" />
            <stroke
                android:width="@dimen/tile_focus_stroke"
                android:color="@color/danger" />
        </shape>
    </item>

    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/menu_row_corner" />
            <solid android:color="@color/danger_container" />
            <stroke
                android:width="@dimen/tile_focus_stroke"
                android:color="@color/danger" />
        </shape>
    </item>

    <item android:drawable="@android:color/transparent" />

</selector>
