<?xml version="1.0" encoding="utf-8"?>
<!--
    Quit on the running card (companion_pc_details), the mock's .act.dng: a pill in the danger
    container. The d-pad's place (state_activated) and a press add the 2dp ring in the danger
    tone, as @drawable/menu_row_danger_bg does, so the row never flashes the signal colour on its
    way to a confirmation. Inset as Resume's pill is, so the two stand the same height.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="120">

    <item android:state_pressed="true">
        <inset
            android:insetBottom="@dimen/pc_details_ring_gap"
            android:insetLeft="@dimen/pc_details_ring_gap"
            android:insetRight="@dimen/pc_details_ring_gap"
            android:insetTop="@dimen/pc_details_ring_gap">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/pill_corner" />
                <solid android:color="@color/danger_container" />
                <stroke
                    android:width="@dimen/tile_focus_stroke"
                    android:color="@color/danger" />
            </shape>
        </inset>
    </item>

    <item android:state_activated="true">
        <inset
            android:insetBottom="@dimen/pc_details_ring_gap"
            android:insetLeft="@dimen/pc_details_ring_gap"
            android:insetRight="@dimen/pc_details_ring_gap"
            android:insetTop="@dimen/pc_details_ring_gap">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/pill_corner" />
                <solid android:color="@color/danger_container" />
                <stroke
                    android:width="@dimen/tile_focus_stroke"
                    android:color="@color/danger" />
            </shape>
        </inset>
    </item>

    <item>
        <inset
            android:insetBottom="@dimen/pc_details_ring_gap"
            android:insetLeft="@dimen/pc_details_ring_gap"
            android:insetRight="@dimen/pc_details_ring_gap"
            android:insetTop="@dimen/pc_details_ring_gap">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/pill_corner" />
                <solid android:color="@color/danger_container" />
            </shape>
        </inset>
    </item>

</selector>
