<?xml version="1.0" encoding="utf-8"?>
<!--
    Over a game's backdrop art: an even dim so the text on top reads against it, and a
    stronger fade into true black at the top and at the bottom. Drawn by the companion panel's
    browsing surface, whose hosts row sits on the bottom fade.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="#B3000000" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FF000000"
                android:centerColor="#00000000"
                android:endColor="#00000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#F2000000"
                android:centerColor="#00000000"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
