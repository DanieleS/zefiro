<?xml version="1.0" encoding="utf-8"?>
<!--
    The Stats remote's period buttons on the companion panel, after the mock's .big: a dark
    card, dimmer still when there is no period that way. The d-pad's place (state_activated, the
    panel's virtual focus) wears the same 2dp signal ring as every other stop (@drawable/stop_bg);
    a press fills it with the wash.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="120">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/segment_track_corner" />
            <solid android:color="@color/signal_wash" />
            <stroke
                android:width="@dimen/tile_focus_stroke"
                android:color="@color/signal" />
        </shape>
    </item>

    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/segment_track_corner" />
            <solid android:color="@color/surface" />
            <stroke
                android:width="@dimen/tile_focus_stroke"
                android:color="@color/signal" />
        </shape>
    </item>

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/segment_track_corner" />
            <solid android:color="@color/surface_container_low" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/segment_track_corner" />
            <solid android:color="@color/surface" />
        </shape>
    </item>

</selector>
