<?xml version="1.0" encoding="utf-8"?>
<!--
    The ground of a PC tile (item_pc_tile): a quiet raised fill, and when the d-pad is on it the
    signal container with the 2dp signal ring, the same grammar as @drawable/stop_bg. A press
    fills it with the wash, as every other control does.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="120">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/pc_tile_corner" />
            <solid android:color="@color/signal_container" />
            <stroke
                android:width="@dimen/tile_focus_stroke"
                android:color="@color/signal" />
        </shape>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/pc_tile_corner" />
            <solid android:color="@color/signal_container" />
            <stroke
                android:width="@dimen/tile_focus_stroke"
                android:color="@color/signal" />
        </shape>
    </item>

    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/pc_tile_corner" />
            <solid android:color="@color/signal_container" />
            <stroke
                android:width="@dimen/tile_focus_stroke"
                android:color="@color/signal" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/pc_tile_corner" />
            <solid android:color="@color/surface_container_low" />
        </shape>
    </item>

</selector>
