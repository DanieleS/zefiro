<?xml version="1.0" encoding="utf-8"?>
<!--
    One segment of a segmented control, drawn inset inside its 48dp touch target. The chosen
    one is filled with the signal's container, as the mocks' .seg's "on" button. The ring is the
    stop's: focus inline, activated on the companion panel, over the fill when the ringed
    segment is also the chosen one.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="120">

    <item android:state_pressed="true">
        <inset
            android:insetBottom="@dimen/segment_item_inset"
            android:insetTop="@dimen/segment_item_inset">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/segment_item_corner" />
                <solid android:color="@color/signal_wash" />
                <stroke
                    android:width="@dimen/tile_focus_stroke"
                    android:color="@color/signal" />
            </shape>
        </inset>
    </item>

    <item android:state_focused="true" android:state_selected="true">
        <inset
            android:insetBottom="@dimen/segment_item_inset"
            android:insetTop="@dimen/segment_item_inset">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/segment_item_corner" />
                <solid android:color="@color/signal_container" />
                <stroke
                    android:width="@dimen/tile_focus_stroke"
                    android:color="@color/signal" />
            </shape>
        </inset>
    </item>

    <item android:state_activated="true" android:state_selected="true">
        <inset
            android:insetBottom="@dimen/segment_item_inset"
            android:insetTop="@dimen/segment_item_inset">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/segment_item_corner" />
                <solid android:color="@color/signal_container" />
                <stroke
                    android:width="@dimen/tile_focus_stroke"
                    android:color="@color/signal" />
            </shape>
        </inset>
    </item>

    <item android:state_focused="true">
        <inset
            android:insetBottom="@dimen/segment_item_inset"
            android:insetTop="@dimen/segment_item_inset">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/segment_item_corner" />
                <solid android:color="@android:color/transparent" />
                <stroke
                    android:width="@dimen/tile_focus_stroke"
                    android:color="@color/signal" />
            </shape>
        </inset>
    </item>

    <item android:state_activated="true">
        <inset
            android:insetBottom="@dimen/segment_item_inset"
            android:insetTop="@dimen/segment_item_inset">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/segment_item_corner" />
                <solid android:color="@android:color/transparent" />
                <stroke
                    android:width="@dimen/tile_focus_stroke"
                    android:color="@color/signal" />
            </shape>
        </inset>
    </item>

    <item android:state_selected="true">
        <inset
            android:insetBottom="@dimen/segment_item_inset"
            android:insetTop="@dimen/segment_item_inset">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/segment_item_corner" />
                <solid android:color="@color/signal_container" />
            </shape>
        </inset>
    </item>

    <item android:drawable="@android:color/transparent" />

</selector>
