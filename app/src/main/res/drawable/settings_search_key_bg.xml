<?xml version="1.0" encoding="utf-8"?>
<!--
    A key on a surface_container control, one step lighter than it: the Y glyph on the Settings
    search field (the mock's .k on .srch), X on the Library's host chip. The hint's own key
    (key_glyph_bg) would vanish into it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/key_glyph_corner" />
    <solid android:color="@color/surface_container_highest" />
</shape>
