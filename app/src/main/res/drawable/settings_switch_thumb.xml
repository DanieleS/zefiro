<?xml version="1.0" encoding="utf-8"?>
<!-- The thumb of settings_switch_track: the signal when on (selected), muted when off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/signal" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/content_muted" />
        </shape>
    </item>
</selector>
