<?xml version="1.0" encoding="utf-8"?>
<!--
    Quit game on the companion panel's controls sheet: @drawable/controls_danger_bg with the ring
    on state_selected, the panel having no focus to give (see @drawable/companion_sheet_tile_bg).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="120">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/controls_tile_corner" />
            <solid android:color="@color/signal_wash" />
            <stroke
                android:width="@dimen/tile_focus_stroke"
                android:color="@color/signal" />
        </shape>
    </item>

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/controls_tile_corner" />
            <solid android:color="@color/danger_container" />
            <stroke
                android:width="@dimen/tile_focus_stroke"
                android:color="@color/signal" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/controls_tile_corner" />
            <solid android:color="@color/danger_container" />
        </shape>
    </item>

</selector>
