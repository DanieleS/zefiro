<?xml version="1.0" encoding="utf-8"?>
<!--
    The Library's host chip: the mocks' dark pill, 36dp tall inside a 48dp touch target (the
    insets are the difference, as for Widget.Zefiro.HeaderChip). It is a plain layout rather
    than a MaterialButton because it carries two glyphs, the status dot before the name and
    the chevron after it, and a MaterialButton draws only one. Focus is the signal ring; a
    press fills it with the wash, like every other control.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="120">

    <item android:state_pressed="true">
        <inset
            android:insetBottom="@dimen/header_chip_inset"
            android:insetTop="@dimen/header_chip_inset">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/header_chip_corner" />
                <solid android:color="@color/signal_wash" />
                <stroke
                    android:width="@dimen/tile_focus_stroke"
                    android:color="@color/signal" />
            </shape>
        </inset>
    </item>

    <item android:state_focused="true">
        <inset
            android:insetBottom="@dimen/header_chip_inset"
            android:insetTop="@dimen/header_chip_inset">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/header_chip_corner" />
                <solid android:color="@color/surface_container" />
                <stroke
                    android:width="@dimen/tile_focus_stroke"
                    android:color="@color/signal" />
            </shape>
        </inset>
    </item>

    <item>
        <inset
            android:insetBottom="@dimen/header_chip_inset"
            android:insetTop="@dimen/header_chip_inset">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/header_chip_corner" />
                <solid android:color="@color/surface_container" />
            </shape>
        </inset>
    </item>

</selector>
