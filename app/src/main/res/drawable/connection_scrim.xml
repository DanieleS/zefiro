<?xml version="1.0" encoding="utf-8"?>
<!--
    Over the connection scene's art: black at the foot, where the cover, the title and Cancel
    sit, thinning to nothing two thirds of the way up, so the game's art reads above them and
    the words hold on any picture under them.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:centerColor="#73000000"
        android:centerY="0.4"
        android:endColor="#00000000"
        android:startColor="#F2000000" />
</shape>
