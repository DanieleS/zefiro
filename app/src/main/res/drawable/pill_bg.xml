<?xml version="1.0" encoding="utf-8"?>
<!--
    A pill, after the mocks' .pill: a fully rounded capsule in the signal's container, for the
    small labels that mark a state rather than take a press (NEW, a changed value). Not a
    control, so it has no focus or press state; a tint can recolour it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/pill_corner" />
    <solid android:color="@color/signal_container" />
</shape>
