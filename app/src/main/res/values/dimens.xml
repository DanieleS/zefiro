<resources>

    <!-- Default screen margins, per the Android Design guidelines. -->
    <dimen name="activity_horizontal_margin">16dp</dimen>
    <dimen name="activity_vertical_margin">16dp</dimen>
    <dimen name="tv_channel_logo_width">80dp</dimen>
    <dimen name="tv_channel_logo_height">80dp</dimen>

    <!--
        Grid tiles. The cell is the art, exactly: the space between tiles is the grid's
        spacing, not padding inside the cell. AbsListView positions the focus ring on the
        bounds of the cell, so this is what puts the ring on the edge of the art.
    -->
    <dimen name="tile_corner">10dp</dimen>
    <dimen name="tile_spacing">20dp</dimen>
    <dimen name="tile_corner_small">6dp</dimen>
    <dimen name="tile_spacing_small">10dp</dimen>
    <dimen name="tile_focus_stroke">2dp</dimen>

    <!--
        The game tile's own layers: the RUNNING badge pinned in a corner of the art, and the
        title card's inset, which keeps a three-line title clear of the rounded corners.
    -->
    <dimen name="tile_badge_corner">4dp</dimen>
    <dimen name="tile_badge_margin">5dp</dimen>
    <dimen name="tile_title_padding">7dp</dimen>

    <!-- The PC cells are an icon over a label rather than art, and are ringed as a whole. -->
    <dimen name="pc_tile_corner">12dp</dimen>

    <!--
        A PC is a card rather than a tile: it carries a name, a state, an address and, when
        the host is in a game, that game's art. The cards stack in one column and stop
        widening at pc_card_max_width, so a PC on a TV is a card and not a banner.
    -->
    <dimen name="pc_card_corner">14dp</dimen>
    <dimen name="pc_card_max_width">560dp</dimen>
    <dimen name="pc_card_min_height">120dp</dimen>
    <dimen name="pc_card_spacing">12dp</dimen>
    <dimen name="pc_card_padding">16dp</dimen>
    <!-- The leading slot holds either the host glyph or the running game's cover, and is the
         width of the cover so the text starts in the same place either way. -->
    <dimen name="pc_card_leading_width">66dp</dimen>
    <dimen name="pc_card_leading_height">88dp</dimen>
    <dimen name="pc_card_glyph">44dp</dimen>
    <dimen name="pc_status_dot">8dp</dimen>

    <!--
        The actions along the top. The icons are drawn fitCenter inside this padding rather
        than stretched to fill it: the vectors declare themselves 256dp wide, and fitXY on a
        70x65 button is what squashed them.
    -->
    <dimen name="top_bar_height">64dp</dimen>
    <dimen name="top_bar_padding">12dp</dimen>
    <dimen name="action_size">48dp</dimen>
    <dimen name="action_icon_inset">12dp</dimen>

    <!--
        Menus, in either home (the library sheet and the in-game panel). One surface, one
        row, whatever contains them.
    -->
    <dimen name="menu_sheet_corner">22dp</dimen>
    <dimen name="menu_sheet_max_width">360dp</dimen>
    <dimen name="menu_sheet_padding">10dp</dimen>
    <dimen name="menu_row_corner">10dp</dimen>
    <dimen name="menu_row_min_height">48dp</dimen>
    <dimen name="menu_row_icon">22dp</dimen>

    <!-- The companion picker's grid of installed apps. The column is the icon plus room for a
         two-line name; the icon is launcher-sized, since recognising it is the whole point. -->
    <dimen name="companion_app_icon">52dp</dimen>
    <dimen name="companion_app_column">96dp</dimen>
    <dimen name="companion_app_spacing">6dp</dimen>
    <dimen name="companion_picker_max_width">460dp</dimen>

    <!--
        The Material 3 shape ladder, in this app's terms. Material components read these
        three off the theme; the sizes are Zefiro's own rounding rather than M3's
        defaults, so a themed dialog and a hand-drawn menu sheet round to the same eye.
    -->
    <dimen name="shape_corner_small">10dp</dimen>
    <dimen name="shape_corner_medium">16dp</dimen>
    <dimen name="shape_corner_large">24dp</dimen>

    <!-- Dialogs round to the large step. Their own token so it can move without the ladder. -->
    <dimen name="dialog_corner">24dp</dimen>

    <!--
        The settings screen. A top app bar over a scrolling column of preferences, laid on
        the ground with the same 16dp gutter the rest of the app keeps.
    -->
    <dimen name="settings_bar_height">56dp</dimen>
    <dimen name="settings_gutter">16dp</dimen>
    <dimen name="settings_category_top">20dp</dimen>

    <!-- Statistics: the cards, the widest the screen grows to on a big display, and the sheets. -->
    <dimen name="stats_card_corner">14dp</dimen>
    <dimen name="stats_max_width">1100dp</dimen>
    <dimen name="stats_sheet_max_width">560dp</dimen>
    <dimen name="stats_list_max_width">640dp</dimen>
    <dimen name="stats_gutter">24dp</dimen>

    <!--
        The main screen's navigation. The rail is narrow and icon-only, as in the mocks: on the
        Thor it costs width, which a landscape screen has to spare, rather than height. Its
        items stay at least 56dp tall, so each one is a full touch target around a 40dp
        indicator. The bottom bar's pill is the mocks' 52 by 28.

        The Thor mock draws the rail at 56 and only the phone at 72. One width is kept on
        purpose: the window size cannot tell a Thor from a landscape phone (their dp sizes
        overlap), and of the two only 72 suits both: it is Material's own rail width, and the
        focus ring keeps clear space around the 40dp indicator. The Thor gives up 16dp of
        width for it.
    -->
    <dimen name="nav_rail_width">72dp</dimen>
    <dimen name="nav_rail_item_min_height">56dp</dimen>
    <!-- Brings ic_settings to 24dp inside a 56dp rail cell, the size of the rail's own icons. -->
    <dimen name="nav_rail_settings_icon_padding">16dp</dimen>
    <dimen name="nav_rail_padding_top">12dp</dimen>
    <dimen name="nav_rail_indicator_size">40dp</dimen>
    <dimen name="nav_rail_indicator_corner">12dp</dimen>
    <dimen name="nav_bottom_indicator_width">52dp</dimen>
    <dimen name="nav_bottom_indicator_height">28dp</dimen>
    <dimen name="nav_bottom_indicator_corner">14dp</dimen>
    <dimen name="nav_item_focus_inset">6dp</dimen>
    <dimen name="nav_item_focus_inset_vertical">2dp</dimen>
    <dimen name="nav_item_focus_corner">14dp</dimen>

    <!-- The profile avatar under the rail: a 48dp target holding a 40dp disc. -->
    <dimen name="nav_avatar_size">48dp</dimen>
    <dimen name="nav_avatar_inset">4dp</dimen>
    <dimen name="nav_avatar_icon_size">20dp</dimen>
    <dimen name="nav_avatar_margin_bottom">12dp</dimen>

    <!--
        A section's header: its title on the left, its actions as chips on the right, as the
        mocks draw "Library" over the shelves. The gutter is the narrowest the column gets; a
        wider window centres the column instead (see PcsFragment).
    -->
    <dimen name="section_gutter">16dp</dimen>
    <dimen name="section_header_padding_top">16dp</dimen>
    <dimen name="section_header_padding_bottom">12dp</dimen>
    <dimen name="section_title_size">26sp</dimen>
    <!-- A 48dp touch target that draws a 36dp pill: the insets are the difference. -->
    <dimen name="header_chip_inset">6dp</dimen>
    <dimen name="header_chip_corner">18dp</dimen>
    <dimen name="header_chip_icon">18dp</dimen>

</resources>
