<?xml version="1.0" encoding="utf-8"?>
<!--
    The palette. Every colour the app draws comes from here.

    The scale is the one the companion surface arrived at: a cold near-black ground,
    content in four steps of prominence, hairlines rather than drop shadows, and exactly
    one saturated hue, spent only on what is live or what is focused.
-->
<resources>

    <!-- Grounds, darkest first. surface_deep is true black: on the OLED panels it is the
         void, pixels physically off, so a lifted near-black does not glow beside the game
         or the bezel. -->
    <color name="surface_deep">#FF000000</color>
    <color name="surface">#FF1A1A1A</color>
    <color name="surface_raised">#FF212121</color>

    <!-- Laid over the stream, where the game is the ground. -->
    <color name="scrim">#80000000</color>

    <!-- Laid over box art, to say the app behind it is already running. -->
    <color name="scrim_soft">#66000000</color>

    <!--
        The RUNNING badge on a game tile. It is the signal, deliberately: a running game is
        the one thing in the library that is live, which is what the signal is spent on. Its
        own name so the badge can move off the signal without touching focus.
    -->
    <color name="running_badge">#FF4FC3F7</color>

    <!--
        The title card of a game with no cover, as the approved See all mock draws it: a
        slightly blue-cold surface and a hairline a step brighter than outline_variant, so a
        card reads as a tile among covers and not as a gap in the grid.
    -->
    <color name="tile_placeholder">#FF1A1D22</color>
    <color name="tile_placeholder_outline">#FF333944</color>

    <!-- Content, most prominent first. -->
    <color name="content_primary">#FFF2F5F8</color>
    <color name="content_secondary">#FFBFC7D2</color>
    <color name="content_muted">#FF8A94A6</color>
    <color name="content_faint">#FF6E7A8A</color>

    <!-- Hairline rules. -->
    <color name="divider">#22FFFFFF</color>

    <!-- The signal. -->
    <color name="signal">#FF4FC3F7</color>

    <!--
        A PC that is online and paired, as its status dot: green, as in the approved mocks, so
        "this PC can be played on" never reads as the signal's "this is focused" or "running".
    -->
    <color name="status_online">#FF7EE08A</color>

    <!--
        The stream HUD's health dot (StreamHealth): the only place the app speaks in traffic
        lights, so the three are their own names. Good is the mock's green, the same as a PC
        that is online; warn and bad are softened amber and red, bright enough to read as a
        6dp dot over any game but kept inside the cold, low-glow scale.
    -->
    <color name="health_good">#FF7EE08A</color>
    <color name="health_warn">#FFF2C46D</color>
    <color name="health_bad">#FFF28B82</color>

    <!-- Behind the stream HUD: the mock's 60% black, darker than @color/scrim so the
         one line of numbers holds over a bright frame. -->
    <color name="hud_scrim">#99000000</color>

    <!-- The signal, thinned to a wash, for the moment a focused tile is pressed. -->
    <color name="signal_wash">#334FC3F7</color>

    <!--
        The signal, sunk into the ground: a deep, desaturated teal-blue for a filled
        container that must still read as "the accent" without emitting the light a full
        signal fill would. Used for Material's primaryContainer (selected chips, tonal
        buttons) so those components stay on-brand and OLED-quiet.
    -->
    <color name="signal_container">#FF10333F</color>

    <!--
        The signal container a step deeper: a PC tile's icon box while the tile is focused. The
        tile itself is the container then, and the box has to stay a box on it, as the PCs mock
        draws it.
    -->
    <color name="pc_tile_icon_focused">#FF0B2730</color>

    <!--
        Read on the signal. The accent is a light blue, so what sits on top of it is the
        ground, not white.
    -->
    <color name="on_signal">#FF00131A</color>

    <!--
        The one warning hue. Kept for Material's error role (destructive dialogs, invalid
        input). A muted rose rather than a fire-engine red, to sit inside the same cold,
        low-glow scale as everything else.
    -->
    <color name="danger">#FFF2B8B5</color>
    <color name="danger_container">#FF3A1512</color>
    <color name="on_danger">#FF370B08</color>

    <!--
        Surface containers, the Material 3 tonal ladder, expressed in this app's terms:
        near-black grounds that step up by a hair rather than by a lift. They exist so
        Material components (dialogs, sheets, menus) that ask for a container surface get
        one that belongs to the OLED scale instead of Material's lifted greys.
    -->
    <color name="surface_container_lowest">#FF000000</color>
    <color name="surface_container_low">#FF161616</color>
    <color name="surface_container">#FF1E1E1E</color>
    <color name="surface_container_high">#FF262626</color>
    <color name="surface_container_highest">#FF2E2E2E</color>

    <!--
        A solid outline, for the strokes Material draws (outlined buttons, text fields,
        switch tracks). @color/divider is a translucent hairline meant to lie over a known
        ground; an outline has to hold on its own, so it is opaque.
    -->
    <color name="outline">#FF4A5361</color>
    <color name="outline_variant">#FF2A2E34</color>

    <!--
        The hero's second button (Quit game) after the mock's .ghost pill: a white wash over
        whatever the backdrop is, so it reads as a button on art and on the plain card alike
        without competing with the one filled button beside it.
    -->
    <color name="ghost_fill">#1AFFFFFF</color>

    <!--
        Laid over the hero's backdrop, left to right: near-opaque where the title and buttons
        sit, thinning towards the right so the art still shows. Its own pair so the hero can be
        retuned without touching the stream's scrims.
    -->
    <color name="hero_scrim_start">#E6000000</color>
    <color name="hero_scrim_end">#59000000</color>

    <!--
        The in-stream side panel (StreamControlsPanel). The scrim is the mock's 35% black: the
        game stays readable behind it, so the panel reads as laid over a running stream rather
        than as a screen of its own. The edge handle is a white pill whose alpha is set where it
        is drawn, faint at rest and full under the finger.
    -->
    <color name="controls_scrim">#59000000</color>
    <color name="edge_handle">#FFF2F5F8</color>

    <!--
        The charts' bars, after the Stats and game page mocks. A bar is the signal
        sunk into the ground; one with nothing in it a step of grey; a period that has not
        happened yet barely there. The selected bar is drawn in @color/signal.
    -->
    <color name="chart_bar">#FF1B4554</color>
    <color name="chart_bar_future">#FF151515</color>
    <color name="chart_bar_zero">#FF262626</color>
    <!-- The game page's twelve-week bars, a little greyer than the Stats chart's. -->
    <color name="week_bar">#FF2C4652</color>
    <!-- Screens T3: the text on the game page's green RUNNING badge. -->
    <color name="on_status_online">#FF08210C</color>

    <!--
        Screens T8: the Settings section's pinned card, after its mock: the signal's container
        sunk half a step further, so the card reads as one block of the accent's family without
        competing with a selected chip, and a hairline of the same family between its pins.
    -->
    <color name="settings_card">#FF0D2129</color>
    <color name="settings_card_rule">#FF1E3A45</color>

</resources>
