<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Base application theme. Material 3 is available from API 21, so there is one of
        these rather than one per API level; res/values-v29 adds only what genuinely
        needs API 29.
    -->
    <style name="AppBaseTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Application theme. -->
    <style name="AppTheme" parent="AppBaseTheme">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:windowBackground">@color/surface</item>

        <!--
            Zefiro's palette, bound to the Material 3 colour roles. Every Material
            component the app inflates — dialogs, the top app bar, switches, preferences —
            reads its colours from these roles, so it is skinned from this one palette
            rather than from Material's lifted-grey defaults. Nothing here is a new colour;
            it is only the map from our names to Material's.
        -->
        <item name="colorPrimary">@color/signal</item>
        <item name="colorOnPrimary">@color/on_signal</item>
        <item name="colorPrimaryContainer">@color/signal_container</item>
        <item name="colorOnPrimaryContainer">@color/signal</item>
        <item name="colorSecondary">@color/content_secondary</item>
        <item name="colorOnSecondary">@color/on_signal</item>
        <item name="colorSecondaryContainer">@color/surface_container_high</item>
        <item name="colorOnSecondaryContainer">@color/content_primary</item>
        <item name="colorTertiary">@color/signal</item>
        <item name="colorOnTertiary">@color/on_signal</item>

        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/content_primary</item>
        <item name="colorSurfaceVariant">@color/surface_raised</item>
        <item name="colorOnSurfaceVariant">@color/content_muted</item>
        <item name="colorSurfaceContainerLowest">@color/surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/surface_container_low</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_container_highest</item>
        <item name="colorSurfaceBright">@color/surface_raised</item>
        <item name="colorSurfaceDim">@color/surface_deep</item>

        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>

        <item name="colorError">@color/danger</item>
        <item name="colorOnError">@color/on_danger</item>
        <item name="colorErrorContainer">@color/danger_container</item>
        <item name="colorOnErrorContainer">@color/danger</item>

        <item name="android:textColorPrimary">@color/content_primary</item>
        <item name="android:textColorSecondary">@color/content_secondary</item>
        <item name="android:textColorHint">@color/content_faint</item>

        <!-- The shape ladder, so a themed Material surface rounds like a hand-drawn one. -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Zefiro.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Zefiro.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Zefiro.LargeComponent</item>

        <!-- Component overlays: the palette reaches dialogs and preferences through these. -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Zefiro.MaterialAlertDialog</item>
        <!-- androidx.preference raises its ListPreference/EditTextPreference dialogs
             through AppCompat's AlertDialog, which reads alertDialogTheme and never sees
             materialAlertDialogTheme; without this they stay on Material's stock grey. -->
        <item name="alertDialogTheme">@style/ThemeOverlay.Zefiro.AlertDialog</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.Zefiro</item>

        <!-- The main screen's rail and bottom bar, and every bottom sheet raised from it. -->
        <item name="navigationRailStyle">@style/Widget.Zefiro.NavigationRail</item>
        <item name="bottomNavigationStyle">@style/Widget.Zefiro.BottomNavigation</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Zefiro.BottomSheetDialog</item>
    </style>

    <style name="StreamBaseTheme" parent="AppBaseTheme">
        <!-- Transparent streaming background to avoid extra overdraw -->
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- Stream activity theme -->
    <style name="StreamTheme" parent="StreamBaseTheme">
        <!-- All customizations that are NOT specific to a particular API-level can go here. -->
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Added for API 34+ where ImageButton requires these color attrs to inflate -->
        <item name="android:colorControlNormal">@android:color/white</item>
        <item name="android:colorControlHighlight">@android:color/white</item>
        <item name="android:colorAccent">@android:color/white</item>
        <item name="android:colorControlActivated">@android:color/white</item>
        <item name="android:colorButtonNormal">@android:color/white</item>
        <!-- Duplicate non-prefixed color attributes for AppCompat widgets -->
        <item name="colorControlNormal">@android:color/white</item>
        <item name="colorControlHighlight">@android:color/white</item>
        <item name="colorAccent">@android:color/white</item>
        <item name="colorControlActivated">@android:color/white</item>
        <item name="colorButtonNormal">@android:color/white</item>
    </style>

    <!-- Settings, profiles: the app theme, with nothing to add to it. -->
    <style name="SettingsTheme" parent="AppTheme" />

    <!--
        The in-game menu panel: a floating, transparent-windowed dialog that dims the game
        behind it. The panel supplies its own raised surface, so the window brings none.
    -->
    <style name="MenuSheetDialog" parent="Theme.Material3.Dark.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <!--
        The touchpad controller, drawn on a panel next to the game. Black rather than
        @color/surface so the panel emits as little light as possible beside the picture.
    -->
    <style name="ExternalDisplayControllerTheme" parent="AppTheme">
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- A round icon action in a section's header, such as See all's back. -->
    <style name="HeaderAction">
        <item name="android:layout_width">@dimen/action_size</item>
        <item name="android:layout_height">@dimen/action_size</item>
        <item name="android:padding">@dimen/action_icon_inset</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/action_button_bg</item>
        <item name="android:tint">@color/action_icon_tint</item>
        <item name="android:focusable">true</item>
    </style>

    <!--
        The action on a PC card. An outlined button rather than a filled one: the card is
        already a surface, and the signal is spent on focus, not on decoration.
    -->
    <style name="PcCardAction" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">@dimen/action_size</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/content_primary</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="strokeColor">@color/pc_card_action_stroke</item>
        <item name="strokeWidth">@dimen/tile_focus_stroke</item>
        <item name="rippleColor">@color/signal_wash</item>
    </style>

    <!--
        Box art corners. The art is rounded by the ImageView itself rather than by a
        CardView, which would only be there to cast a shadow we do not want.
    -->
    <style name="TileShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/tile_corner</item>
    </style>

    <style name="TileShapeSmall">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/tile_corner_small</item>
    </style>

    <declare-styleable name="ApertureViewGroup">
        <attr name="aperture_color1" format="color" />
        <attr name="aperture_color2" format="color" />
        <attr name="aperture_border_width" format="dimension" />
        <attr name="aperture_border_angle" format="dimension" />
        <attr name="aperture_duration" format="integer" />
        <attr name="aperture_middle_color" format="color" />
    </declare-styleable>

    <!-- Companion surface: a headline stat tile, and a label/value line for secondary detail. -->
    <!-- A section's label on the companion panel's browsing surface: "Focused", "Hosts". -->
    <style name="CompanionSectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/content_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="CompanionTileLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/content_muted</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="CompanionTileValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/content_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>

    <style name="CompanionDetailLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/content_faint</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="CompanionDetailValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/content_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- ============================================================================
         Material 3 shape ladder. The three sizes Material reads off the theme, rounded
         to Zefiro's own radii so a themed component and a hand-drawn one agree.
         ============================================================================ -->
    <style name="ShapeAppearance.Zefiro.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/shape_corner_small</item>
    </style>

    <style name="ShapeAppearance.Zefiro.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/shape_corner_medium</item>
    </style>

    <style name="ShapeAppearance.Zefiro.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/shape_corner_large</item>
    </style>

    <!-- ============================================================================
         The dialog. A Material 3 alert dialog, wearing the same clothes as a menu sheet:
         a raised surface on true black, rounded to the large step, the signal on its
         buttons, and content in the app's four steps of prominence. Bound to the theme's
         materialAlertDialogTheme, so every MaterialAlertDialogBuilder inherits it; also
         applied by hand where a dialog is raised from the stream (a context that does not
         descend from AppTheme).
         ============================================================================ -->
    <style name="ThemeOverlay.Zefiro.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <!-- Raise the dialog off the ground, like the menu sheet, rather than sitting it
             flat on @color/surface. Both the old and new Material dialog backgrounds are
             covered: colorSurface for 1.x, colorSurfaceContainerHigh for the newer roles. -->
        <item name="colorSurface">@color/surface_raised</item>
        <item name="colorSurfaceContainerHigh">@color/surface_raised</item>
        <item name="android:colorBackground">@color/surface_raised</item>

        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Zefiro.Dialog</item>

        <item name="buttonBarPositiveButtonStyle">@style/Widget.Zefiro.Button.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Zefiro.Button.Dialog</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Zefiro.Button.Dialog</item>

        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.Zefiro.Title</item>

        <item name="android:textColorPrimary">@color/content_primary</item>
        <item name="android:textColorSecondary">@color/content_secondary</item>
    </style>

    <style name="ShapeAppearanceOverlay.Zefiro.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/dialog_corner</item>
    </style>

    <!-- ============================================================================
         The same dialog for the AppCompat path, which androidx.preference uses. Parented
         on Dialog.Alert rather than the MaterialAlertDialog overlay: that one is meant for
         MaterialAlertDialogBuilder and swaps in a layout whose ids AppCompat does not
         inflate into. Only colour, type and a rounded surface are set here; the dialog's
         structure is left to AppCompat.
         ============================================================================ -->
    <style name="ThemeOverlay.Zefiro.AlertDialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="colorSurface">@color/surface_raised</item>
        <item name="colorSurfaceContainerHigh">@color/surface_raised</item>
        <item name="android:colorBackground">@color/surface_raised</item>
        <item name="android:windowBackground">@drawable/dialog_background_zefiro</item>

        <item name="android:textColorPrimary">@color/content_primary</item>
        <item name="android:textColorSecondary">@color/content_secondary</item>
        <item name="android:textColorAlertDialogListItem">@color/content_primary</item>
    </style>

    <!-- The dialog's buttons: text buttons carrying the signal, the wash on a press. -->
    <style name="Widget.Zefiro.Button.Dialog" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/signal</item>
        <item name="rippleColor">@color/signal_wash</item>
    </style>

    <style name="MaterialAlertDialog.Zefiro.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/content_primary</item>
    </style>

    <!-- ============================================================================
         Settings. The preference list, themed off the palette, with a category header
         drawn in the app's quiet-label grammar (muted, tracked, upper case) rather than
         Material's coloured one.
         ============================================================================ -->
    <style name="PreferenceThemeOverlay.Zefiro" parent="PreferenceThemeOverlay">
        <item name="preferenceCategoryStyle">@style/Preference.Category.Zefiro</item>

        <!-- Every row the settings screen actually uses. androidx picks the style per
             preference type, so the layout has to be hung on each one; the types not
             listed (checkBoxPreferenceStyle, which SmallIconCheckboxPreference rides on)
             keep their own layout on purpose. -->
        <item name="preferenceStyle">@style/Preference.Zefiro</item>
        <item name="switchPreferenceCompatStyle">@style/Preference.Zefiro.Switch</item>
        <item name="dialogPreferenceStyle">@style/Preference.Zefiro.Dialog</item>
        <item name="editTextPreferenceStyle">@style/Preference.Zefiro.EditText</item>
    </style>

    <style name="Preference.Category.Zefiro" parent="Preference.Category.Material">
        <item name="android:layout">@layout/preference_category_zefiro</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <!-- The app's settings row: see @layout/preference_zefiro for the reasoning. -->
    <style name="Preference.Zefiro" parent="Preference.Material">
        <item name="android:layout">@layout/preference_zefiro</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="Preference.Zefiro.Switch" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="android:layout">@layout/preference_zefiro</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <!--
        Each of these must keep its own androidx parent. Only android:layout — the row in
        the list — is ours; a dialog preference carries android:dialogLayout and its button
        labels in the same style, so re-parenting these onto the plain Preference style
        drops the EditText out of the dialog and takes the button bar with it.
    -->
    <style name="Preference.Zefiro.Dialog" parent="Preference.DialogPreference.Material">
        <item name="android:layout">@layout/preference_zefiro</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="Preference.Zefiro.EditText" parent="Preference.DialogPreference.EditTextPreference.Material">
        <item name="android:layout">@layout/preference_zefiro</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <!-- Two steps of the prominence ladder, not one: the title carries the row, the
         explanation stays underneath it and out of the way. -->
    <style name="TextAppearance.Zefiro.PreferenceTitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/content_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.Zefiro.PreferenceSummary" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/content_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="TextAppearance.Zefiro.PreferenceCategory" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/content_muted</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- The settings top app bar: a plain surface bar, its title in content_primary, its
         back arrow and overflow in the secondary step. No lift, in keeping with the app. -->
    <style name="Widget.Zefiro.Toolbar" parent="Widget.Material3.Toolbar.Surface">
        <item name="android:background">@color/surface_deep</item>
        <item name="android:elevation">0dp</item>
        <item name="titleTextColor">@color/content_primary</item>
        <item name="titleTextAppearance">@style/TextAppearance.Zefiro.Toolbar.Title</item>
        <item name="navigationIconTint">@color/content_secondary</item>
    </style>

    <style name="TextAppearance.Zefiro.Toolbar.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/content_primary</item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- ============================================================================
         Statistics. A quiet eyebrow over each section, as CouchPilot heads its own, and
         figures in mono, as the Stats mock sets them.
         ============================================================================ -->
    <style name="StatsEyebrow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/content_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="StatsEyebrowAside">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:textColor">@color/content_faint</item>
        <item name="android:textSize">11sp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="StatsSectionHead">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">bottom</item>
    </style>

    <!-- The library's four totals, in one card: a figure in mono over what it counts. -->
    <style name="StatsTotal">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <style name="StatsTotalFigure">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/content_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="StatsTotalLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/content_muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- A tab on the Stats bottom screen ("Unlocks 64"), the mock's .tab: a chip, signal when
         active, ringed when the panel's d-pad is on it. Its count is spanned in by the renderer. -->
    <style name="StatsRemoteTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/action_size</item>
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!--
        The main screen's navigation, rail and bottom bar alike: laid on the true-black ground
        rather than on Material's container grey, the selected section in the signal over its
        sunk container, everything else muted. Focus gets the tiles' signal ring through the
        item background, because Material's own focus tint is too faint to find on OLED black;
        that background is a ripple and carries the press wash too, since Material drops its
        itemRippleColor whenever an item background is set.
        Window insets are applied by the main screen itself, which knows when the bars are
        hidden, so the widgets must not pad for them on their own. The rail is told so here.
        The bottom bar has no such attributes (its inset padding is hard-wired), so MainActivity
        replaces its inset listener instead.
    -->
    <style name="Widget.Zefiro.NavigationRail" parent="Widget.Material3.NavigationRailView">
        <item name="android:minWidth">@dimen/nav_rail_width</item>
        <item name="android:background">@color/surface_deep</item>
        <item name="elevation">0dp</item>
        <item name="labelVisibilityMode">unlabeled</item>
        <item name="menuGravity">top</item>
        <item name="itemMinHeight">@dimen/nav_rail_item_min_height</item>
        <item name="itemIconTint">@color/nav_item_tint</item>
        <item name="itemTextColor">@color/nav_item_tint</item>
        <item name="itemBackground">@drawable/nav_item_focus_ring</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Zefiro.NavigationRail.ActiveIndicator</item>
        <item name="paddingTopSystemWindowInsets">false</item>
        <item name="paddingBottomSystemWindowInsets">false</item>
        <item name="paddingStartSystemWindowInsets">false</item>
    </style>

    <style name="Widget.Zefiro.NavigationRail.ActiveIndicator" parent="Widget.Material3.NavigationRailView.ActiveIndicator">
        <item name="android:width">@dimen/nav_rail_indicator_size</item>
        <item name="android:height">@dimen/nav_rail_indicator_size</item>
        <item name="android:color">@color/signal_container</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Zefiro.NavRailIndicator</item>
    </style>

    <style name="ShapeAppearance.Zefiro.NavRailIndicator" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/nav_rail_indicator_corner</item>
    </style>

    <style name="Widget.Zefiro.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/surface_deep</item>
        <item name="elevation">0dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemIconTint">@color/nav_item_tint</item>
        <item name="itemTextColor">@color/nav_item_tint</item>
        <item name="itemBackground">@drawable/nav_item_focus_ring</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Zefiro.BottomNavigation.ActiveIndicator</item>
    </style>

    <style name="Widget.Zefiro.BottomNavigation.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">@dimen/nav_bottom_indicator_width</item>
        <item name="android:height">@dimen/nav_bottom_indicator_height</item>
        <item name="android:color">@color/signal_container</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Zefiro.NavBottomIndicator</item>
    </style>

    <style name="ShapeAppearance.Zefiro.NavBottomIndicator" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/nav_bottom_indicator_corner</item>
    </style>

    <!--
        A section's header (see dimens: section_*). The title is the mocks' big bold word; the
        chip is their dark pill, here a 48dp touch target around a 36dp pill, with the signal
        ring on focus like every other control, since a chip has no other focus state to show.
    -->
    <style name="SectionTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/content_primary</item>
        <item name="android:textSize">@dimen/section_title_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Widget.Zefiro.HeaderChip" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">@dimen/action_size</item>
        <item name="android:insetTop">@dimen/header_chip_inset</item>
        <item name="android:insetBottom">@dimen/header_chip_inset</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/content_primary</item>
        <item name="backgroundTint">@color/surface_container</item>
        <item name="cornerRadius">@dimen/header_chip_corner</item>
        <item name="iconTint">@color/content_primary</item>
        <item name="iconSize">@dimen/header_chip_icon</item>
        <item name="iconPadding">6dp</item>
        <item name="strokeColor">@color/action_stroke</item>
        <item name="strokeWidth">@dimen/tile_focus_stroke</item>
        <item name="rippleColor">@color/signal_wash</item>
    </style>

    <!--
        Bottom sheets. Without this a BottomSheetDialog is painted in Material's
        surfaceContainerLow grey; the palette's step for it is surface_container_low.
    -->
    <style name="ThemeOverlay.Zefiro.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Zefiro.BottomSheet</item>
    </style>

    <style name="Widget.Zefiro.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface_container_low</item>
    </style>

    <!--
        The one filled button on a screen: the way forward (Wake, Pair, Play), as the mocks'
        .play pill draws it, the signal with the ground's colour on it. Focus cannot be the
        signal ring here, since the fill already is the signal, so a focused one is ringed in
        the primary content colour instead.
    -->
    <style name="Widget.Zefiro.PrimaryButton" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">@dimen/action_size</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/on_signal</item>
        <item name="backgroundTint">@color/signal</item>
        <item name="cornerRadius">@dimen/primary_button_corner</item>
        <item name="iconTint">@color/on_signal</item>
        <item name="strokeColor">@color/primary_button_stroke</item>
        <item name="strokeWidth">@dimen/tile_focus_stroke</item>
        <item name="rippleColor">@color/scrim_soft</item>
    </style>

    <!--
        The quiet button beside the filled one (the hero's Quit game): the mock's .ghost pill,
        a white wash with the content colour on it. Its focus is the signal ring, as on a chip.
    -->
    <style name="Widget.Zefiro.GhostButton" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">@dimen/action_size</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/content_primary</item>
        <item name="backgroundTint">@color/ghost_fill</item>
        <item name="cornerRadius">@dimen/primary_button_corner</item>
        <item name="strokeColor">@color/action_stroke</item>
        <item name="strokeWidth">@dimen/tile_focus_stroke</item>
        <item name="rippleColor">@color/signal_wash</item>
    </style>

    <!-- A shelf's label, the mocks' .sect: the row's name in the primary colour, medium weight. -->
    <style name="ShelfLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/content_primary</item>
        <item name="android:textSize">@dimen/shelf_label_size</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- ============================================================================
         Screens T3: the game page.
         ============================================================================ -->

    <!--
        Quit game beside Resume: the mocks' danger pill, the error's container with its light
        text. Focus is the signal ring, as on the ghost button.
    -->
    <style name="Widget.Zefiro.DangerButton" parent="Widget.Zefiro.GhostButton">
        <item name="android:textColor">@color/danger</item>
        <item name="backgroundTint">@color/danger_container</item>
        <item name="iconTint">@color/danger</item>
        <item name="rippleColor">@color/scrim_soft</item>
    </style>

    <!-- A figure on the game page, the mocks' .st b: a mono number in the primary colour. -->
    <style name="GamePageFigure">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/content_primary</item>
        <item name="android:textSize">@dimen/game_page_figure_size</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- The small tracked caption under a figure, the mocks' .cap. -->
    <style name="GamePageCap">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:singleLine">true</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/content_muted</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- A figure's card: the mocks' .st, a quiet fill and nothing to focus. -->
    <style name="GamePageFigureCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/game_page_card_bg</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

</resources>
