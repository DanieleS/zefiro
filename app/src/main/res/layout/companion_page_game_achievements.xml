<?xml version="1.0" encoding="utf-8"?>
<!--
    A game's achievements on the companion panel (stats/GameAchievementsRenderer), after the
    approved GamePage_B mock's Thor bottom screen: the block the main screen shows inline, here
    filling the panel, its header and filter fixed and the list scrolling under them.

    While there is no list, one row in its place, as on the main screen: loading, or the PC
    could not be reached (a tap retries). Nothing here is focusable: the panel's window never
    takes focus, and the d-pad's place is drawn activated.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_deep"
    android:paddingStart="12dp"
    android:paddingTop="14dp"
    android:paddingEnd="12dp">

    <com.limelight.stats.AchievementsBlockView
        android:id="@+id/companionAchievementsBlock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/companionAchievementsStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/stop_bg"
        android:clickable="true"
        android:focusable="false"
        android:gravity="center_vertical"
        android:minHeight="@dimen/action_size"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/companionAchievementsStatusProgress"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="10dp"
            android:indeterminateTint="@color/signal" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/companionAchievementsStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/content_secondary"
                android:textSize="14sp"
                tools:text="Loading…" />

            <TextView
                android:id="@+id/companionAchievementsStatusHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/game_page_retry"
                android:textColor="@color/content_muted"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
