<?xml version="1.0" encoding="utf-8"?>
<!--
    One value on the Settings pinned card in a compact window, after the phone mock's .pv: the
    value in mono over a quiet label, centred, five sharing the card's width. Same ids, and the
    same behaviour, as @layout/item_settings_pin.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/settings_pin_height"
    android:background="@drawable/stop_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:minWidth="@dimen/settings_pill_min_width"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <TextView
        android:id="@+id/settingPinValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:maxWidth="120dp"
        android:singleLine="true"
        android:textColor="@color/content_primary"
        android:textSize="14sp"
        tools:text="1080p" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/settingPinLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:letterSpacing="0.12"
            android:maxWidth="100dp"
            android:singleLine="true"
            android:textAllCaps="true"
            android:textColor="@color/content_muted"
            android:textSize="9sp"
            tools:text="Res" />

        <TextView
            android:id="@+id/settingPinTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/stats_chip_bg"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:singleLine="true"
            android:text="@string/settings_pin_profile_tag"
            android:textColor="@color/signal"
            android:textSize="8sp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
