<?xml version="1.0" encoding="utf-8"?>
<!--
    One essential on the companion panel's pinned settings (settings/SettingsPinnedRenderer): its
    card label on the left, its value in mono on the right, a "profile" tag when the active
    profile sets it. A 56dp touch target on a card fill; never focusable.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/companion_action_row_height"
    android:layout_marginBottom="4dp"
    android:background="@drawable/companion_action_row_bg"
    android:clickable="true"
    android:focusable="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <TextView
        android:id="@+id/companionPinnedLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.12"
        android:singleLine="true"
        android:textAllCaps="true"
        android:textColor="@color/content_muted"
        android:textSize="12sp"
        tools:text="Resolution" />

    <TextView
        android:id="@+id/companionPinnedTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:background="@drawable/pill_bg"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="@string/settings_pin_profile_tag"
        android:textColor="@color/signal"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/companionPinnedValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:maxWidth="220dp"
        android:singleLine="true"
        android:textColor="@color/content_primary"
        android:textSize="15sp"
        tools:text="2560x1600" />

</LinearLayout>
