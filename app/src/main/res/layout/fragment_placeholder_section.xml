<?xml version="1.0" encoding="utf-8"?>
<!-- Stand-in section content: its name and two focusable buttons, to exercise the focus gate. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/settings_gutter">

    <TextView
        android:id="@+id/placeholderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/settings_gutter"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="@color/content_primary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/placeholderFirst"
        style="@style/PcCardAction"
        android:minHeight="@dimen/action_size"
        android:text="@string/placeholder_first_action" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/placeholderSecond"
        style="@style/PcCardAction"
        android:layout_marginTop="@dimen/pc_card_spacing"
        android:minHeight="@dimen/action_size"
        android:text="@string/placeholder_second_action" />

</LinearLayout>
