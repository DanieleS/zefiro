<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Game" >

    <View
        android:id="@+id/backgroundTouchView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />
    
    <com.limelight.ui.StreamContainer
        android:id="@+id/streamContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:defaultFocusHighlightEnabled="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:focusedByDefault="true">
    <requestFocus />
    </com.limelight.ui.StreamContainer>

<!--    <com.limelight.ui.ApertureViewGroup-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="match_parent"-->
<!--        app:aperture_color1="#5CF950"-->
<!--        android:layout_gravity="center"-->
<!--        android:padding="5dp"-->
<!--        app:aperture_color2="#FC9595"-->
<!--        app:aperture_border_width="10dp"-->
<!--        app:aperture_border_angle="24dp"-->
<!--        app:aperture_duration="6000"-->
<!--        app:aperture_middle_color="#6CD2F8">-->
<!--    </com.limelight.ui.ApertureViewGroup>-->

    <!-- The one-line HUD (and the reconnect status): top-left, as on the approved Stream
         mock. Never focusable or clickable, so the stream under it keeps every touch. -->
    <com.limelight.stream.StreamHud
        android:id="@+id/streamHud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="10dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:preferKeepClear="true"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/overlayToggleZoomButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:background="@drawable/floating_menu_button"
        android:src="@drawable/ic_zoom_toggle"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/toggle_pan_zoom_mode"
        android:visibility="gone"
        android:elevation="9999dp" />

    <!-- The way into the stream controls on a phone: a pill on the right edge, in a 24 x 120dp
         touch zone that takes only its own touches (see EdgeHandleView). Above the on-screen
         controller and keyboards, which carry no elevation, and under the connection scene. -->
    <com.limelight.stream.EdgeHandleView
        android:id="@+id/controlsHandle"
        android:layout_width="24dp"
        android:layout_height="120dp"
        android:layout_gravity="right|center_vertical"
        android:elevation="100dp"
        android:visibility="gone" />

    <!-- The stream controls on a phone (StreamControlsPanel). Over everything the stream draws,
         the zoom toggle's 9999dp and the connection scene included: while it is open it is the
         only thing that takes a touch. It has no background of its own, so the height casts no
         shadow. -->
    <com.limelight.stream.StreamControlsPanel
        android:id="@+id/controlsPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="10000dp"
        android:visibility="gone" />

    <!--
        The connection scene (ui/ConnectionOverlay), after the approved proposal C: the game's
        own art full-bleed, as the library's hero and the game page draw it (its background art,
        else its cover darkened, else the bare ground), under a scrim black at the foot. The PC
        in a chip at the top right; at the foot, the cover with STARTING, the game's name and the
        phase the wait is in beside it, and Cancel on the right, focused, so a pad's A presses it
        (and its B, Back or Select cancel from anywhere; see Game#handleKeyDown). The progress is
        a line along the very bottom edge. Shown from the moment the activity is created until
        the stream is live, then faded away. Opaque, so the black surface below never shows.

        connectionContent is kept clear of the display cutout in code; the backdrop, the scrims
        and the line run edge to edge. The sizes are the compact ones, for a phone in landscape;
        ConnectionOverlay takes the large ones on a wide, tall window and moves Cancel under the
        cover in a narrow one.
    -->
    <FrameLayout
        android:id="@+id/connectionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface_deep"
        android:clickable="true"
        android:focusable="false"
        android:elevation="200dp">

        <com.limelight.ui.BackdropImageView
            android:id="@+id/connectionBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/connection_scrim" />

        <View
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_gravity="top"
            android:background="@drawable/connection_scrim_top" />

        <FrameLayout
            android:id="@+id/connectionContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- "● Taverna": the PC the game starts on. Gone without a name. -->
            <LinearLayout
                android:id="@+id/connectionPcChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="@dimen/connection_gutter"
                android:background="@drawable/connection_chip_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp">

                <View
                    android:layout_width="@dimen/pc_status_dot"
                    android:layout_height="@dimen/pc_status_dot"
                    android:background="@drawable/pc_status_dot"
                    android:backgroundTint="@color/status_online" />

                <TextView
                    android:id="@+id/connectionPcName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:maxWidth="240dp"
                    android:singleLine="true"
                    android:textColor="@color/content_secondary"
                    android:textSize="13sp"
                    tools:text="Taverna" />
            </LinearLayout>

            <!-- The foot. Cancel sits at the bottom right and the cover row beside it, aligned on
                 their bottoms; in a narrow window the row goes above Cancel instead (in code). -->
            <RelativeLayout
                android:id="@+id/connectionFoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:paddingStart="@dimen/connection_gutter"
                android:paddingEnd="@dimen/connection_gutter"
                android:paddingBottom="@dimen/connection_gutter">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/connectionCancel"
                    style="@style/Widget.Zefiro.GhostButton"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="16dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:nextFocusUp="@id/connectionCancel"
                    android:nextFocusDown="@id/connectionCancel"
                    android:nextFocusLeft="@id/connectionCancel"
                    android:nextFocusRight="@id/connectionCancel"
                    android:text="@string/cancel"
                    app:iconPadding="8dp" />

                <!-- The cover, rounded as a tile; the game's name stands in without one. -->
                <FrameLayout
                    android:id="@+id/connectionCoverFrame"
                    android:layout_width="@dimen/connection_cover_width"
                    android:layout_height="@dimen/connection_cover_height"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentBottom="true">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/connectionCover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/connection_cover_placeholder"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/TileShape" />

                    <TextView
                        android:id="@+id/connectionCoverTitle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:padding="8dp"
                        android:textColor="@color/content_primary"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/connectionColumn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBottom="@id/connectionCoverFrame"
                    android:layout_marginStart="@dimen/connection_gap"
                    android:layout_toStartOf="@id/connectionCancel"
                    android:layout_toEndOf="@id/connectionCoverFrame"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.14"
                        android:singleLine="true"
                        android:text="@string/conn_scene_tag"
                        android:textAllCaps="true"
                        android:textColor="@color/signal"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/connectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-light"
                        android:includeFontPadding="false"
                        android:lineSpacingMultiplier="0.95"
                        android:maxLines="2"
                        android:textColor="@color/content_primary"
                        android:textSize="@dimen/connection_title_size"
                        tools:text="Hades II" />

                    <!-- Wrapped, so the clock follows the phase rather than the column's end;
                         a phase too long for the room is the one that gives way (ellipsized). -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/connectionPulse"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/connection_pulse_dot" />

                        <TextView
                            android:id="@+id/connectionPhase"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="@color/content_secondary"
                            android:textSize="13sp"
                            tools:text="Negotiating the session…" />

                        <TextView
                            android:id="@+id/connectionElapsed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFeatureSettings="tnum"
                            android:singleLine="true"
                            android:textColor="@color/content_muted"
                            android:textSize="13sp"
                            tools:text="0:07" />
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>
        </FrameLayout>

        <ProgressBar
            android:id="@+id/connectionProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/connection_progress_height"
            android:layout_gravity="bottom"
            android:max="1000"
            android:progress="0"
            android:progressBackgroundTint="@android:color/transparent"
            android:progressTint="@color/signal" />
    </FrameLayout>

</merge>