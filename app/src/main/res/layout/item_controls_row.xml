<?xml version="1.0" encoding="utf-8"?>
<!--
    One row of the stream controls' list and pages, the mock's .row at a 48dp touch target. The
    trailing glyph is a chevron on a row that opens a page, a check on a choice that is in use,
    and gone otherwise. The same ring and press as every other row (@drawable/menu_row_bg).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="2dp"
    android:background="@drawable/menu_row_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/menu_row_min_height"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingTop="6dp"
    android:paddingRight="12dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/controlsRowIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginRight="12dp"
        android:importantForAccessibility="no"
        android:tint="@color/content_secondary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/controlsRowLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/content_primary"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/controlsRowTrailing"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginLeft="12dp"
        android:importantForAccessibility="no"
        android:visibility="gone" />

</LinearLayout>
