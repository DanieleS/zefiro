<?xml version="1.0" encoding="utf-8"?>
<!--
    The Stats section's lower half on the companion panel (stats/StatsRemoteRenderer), after the
    approved Stats mock (C)'s Thor bottom screen, top to bottom:

      remote    Week / Month / Year, then the period as three big buttons: previous, the one
                shown (not a control), next
      tabs      "Unlocks 64" / "Pick up again 4", each only while its list has rows
      rows      the active tab's list, scrolling between the tabs and the totals
      totals    the library's four totals, pinned to the bottom with the hints under them

    Nothing here is focusable: the panel's window never takes focus, and the d-pad's place is
    drawn activated. The rows container is filled in by the renderer
    (companion_page_stats_row).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_deep"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <com.limelight.ui.SegmentedControlView
        android:id="@+id/companionStatsRanges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/companionStatsPrevious"
            android:layout_width="0dp"
            android:layout_height="@dimen/companion_action_row_height"
            android:layout_weight="1"
            android:background="@drawable/stats_period_button_bg"
            android:clickable="true"
            android:contentDescription="@string/stats_previous"
            android:focusable="false"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_left"
                android:tint="@color/content_secondary" />

            <TextView
                android:id="@+id/companionStatsPreviousLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:textColor="@color/content_secondary"
                android:textSize="14sp"
                tools:text="2025" />

        </LinearLayout>

        <TextView
            android:id="@+id/companionStatsCurrent"
            android:layout_width="0dp"
            android:layout_height="@dimen/companion_action_row_height"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/stats_period_current_bg"
            android:ellipsize="end"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:textColor="@color/content_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="2026" />

        <LinearLayout
            android:id="@+id/companionStatsNext"
            android:layout_width="0dp"
            android:layout_height="@dimen/companion_action_row_height"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/stats_period_button_bg"
            android:clickable="true"
            android:contentDescription="@string/stats_next"
            android:focusable="false"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/companionStatsNextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:textColor="@color/content_secondary"
                android:textSize="14sp"
                tools:text="2027" />

            <ImageView
                android:id="@+id/companionStatsNextIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/content_secondary" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/companionStatsTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/companionStatsTabUnlocks"
            style="@style/StatsRemoteTab" />

        <TextView
            android:id="@+id/companionStatsTabResume"
            style="@style/StatsRemoteTab"
            android:layout_marginStart="6dp" />

    </LinearLayout>

    <!-- Fills what the remote and the totals leave, so the totals keep to the bottom even
         without rows. Its edges fade while there are rows beyond them, the cue that the list
         goes on under the totals (or back up under the tabs). -->
    <ScrollView
        android:id="@+id/companionStatsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadingEdgeLength="40dp"
        android:overScrollMode="never"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/companionStatsRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="2dp" />

    </ScrollView>

    <LinearLayout
        android:id="@+id/companionStatsTotals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/stats_totals_bg"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <LinearLayout style="@style/StatsTotal">

            <TextView
                android:id="@+id/companionStatsHours"
                style="@style/StatsTotalFigure" />

            <TextView
                style="@style/StatsTotalLabel"
                android:text="@string/stats_played_total" />

        </LinearLayout>

        <LinearLayout style="@style/StatsTotal">

            <TextView
                android:id="@+id/companionStatsGames"
                style="@style/StatsTotalFigure" />

            <TextView
                android:id="@+id/companionStatsGamesLabel"
                style="@style/StatsTotalLabel" />

        </LinearLayout>

        <LinearLayout style="@style/StatsTotal">

            <TextView
                android:id="@+id/companionStatsNeverPlayed"
                style="@style/StatsTotalFigure" />

            <TextView
                style="@style/StatsTotalLabel"
                android:text="@string/stats_never_played" />

        </LinearLayout>

        <LinearLayout style="@style/StatsTotal">

            <TextView
                android:id="@+id/companionStatsThisYear"
                style="@style/StatsTotalFigure" />

            <TextView
                style="@style/StatsTotalLabel"
                android:text="@string/stats_played_this_year" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/companionStatsNothing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp"
        android:text="@string/stats_remote_nothing"
        android:textColor="@color/content_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <com.limelight.ui.GamepadHintsView
        android:id="@+id/companionStatsHints"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginTop="8dp" />

</LinearLayout>
