<?xml version="1.0" encoding="utf-8"?>
<!--
    The PCs section: a header ("PCs" and the Add PC chip) over one centred column of host cards.

    The column stops widening at pc_card_max_width. The centring is done in code, from this
    fragment's own width rather than the screen's, because the rail takes part of the screen in
    a wide window; the header's padding follows the list's so the title sits over the cards.

    While no host has been seen, the "searching" state stands where the cards will be, and the
    chip is the only thing to focus.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pcsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_deep"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/pcsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/section_gutter"
        android:paddingTop="@dimen/section_header_padding_top"
        android:paddingEnd="@dimen/section_gutter"
        android:paddingBottom="@dimen/section_header_padding_bottom">

        <TextView
            android:id="@+id/pcsTitle"
            style="@style/SectionTitle"
            android:text="@string/nav_pcs" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pcsAddButton"
            style="@style/Widget.Zefiro.HeaderChip"
            android:layout_marginStart="@dimen/pc_card_spacing"
            android:text="@string/pcs_add_pc"
            app:icon="@drawable/ic_plus" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pcsList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/section_gutter"
            android:paddingEnd="@dimen/section_gutter"
            android:paddingBottom="@dimen/section_gutter"
            android:scrollbars="none"
            tools:listitem="@layout/pc_card_item" />

        <LinearLayout
            android:id="@+id/pcsEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:maxWidth="@dimen/pc_card_max_width"
            android:orientation="vertical"
            android:paddingStart="@dimen/section_gutter"
            android:paddingEnd="@dimen/section_gutter">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminate="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/searching_pc"
                android:textColor="@color/content_muted"
                android:textSize="16sp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
