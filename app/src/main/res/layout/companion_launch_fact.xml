<?xml version="1.0" encoding="utf-8"?>
<!--
    One fact of the launch on the companion panel (companion_launch): a label on the left, its
    value on the right. Gone until the value is known.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/companion_launch_fact_height"
    android:orientation="horizontal"
    android:visibility="gone">

    <TextView
        android:id="@+id/launchFactLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textColor="@color/content_muted"
        android:textSize="13sp"
        tools:text="Resolution" />

    <TextView
        android:id="@+id/launchFactValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="end"
        android:singleLine="true"
        android:textColor="@color/content_primary"
        android:textSize="13sp"
        tools:text="1920×1080 · 60 fps" />

</LinearLayout>
