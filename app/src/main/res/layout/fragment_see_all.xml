<?xml version="1.0" encoding="utf-8"?>
<!--
    The Library's See all: every game of the selected host in one grid (library/SeeAllFragment).

    The header follows the approved See all mock, in one of two shapes SeeAllFragment picks from
    the window:

      wide (the rail)   "All games", the host and the count in muted type, and the sort chip on
                        the right, which names the current order and opens the sort sheet
      compact           a toolbar: back (touch only, and only when there is somewhere to go back
                        to), "All games", search and sort buttons; under it, on a line of its
                        own so it never loses the count, "host · N games · order"

    The sort control is the header's one stop the d-pad is meant for, so it goes from the grid
    straight to it. A window with the rail has no back arrow: B goes back, and so does the
    Library's rail item chosen again.

    The grid's side padding is the gutter less half the gap between tiles: each tile carries half
    the gap on every side (GridSpacingItemDecoration), so the outer edge lands on the gutter like
    the header above it. Its column count comes from its own size in code (GridSpanRule).

    Where there are no games to show, the host state panel stands in the grid's place.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/seeAllRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_deep"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/seeAllHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/section_gutter"
        android:paddingTop="@dimen/section_header_padding_top"
        android:paddingEnd="@dimen/section_gutter"
        android:paddingBottom="@dimen/section_header_padding_bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/seeAllBack"
                style="@style/HeaderAction"
                android:layout_marginStart="@dimen/see_all_back_offset"
                android:contentDescription="@string/library_back"
                android:focusable="false"
                android:src="@drawable/ic_arrow_back"
                android:visibility="gone" />

            <TextView
                android:id="@+id/seeAllTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="@string/action_all_games"
                android:textColor="@color/content_primary"
                android:textSize="@dimen/see_all_title_size"
                android:textStyle="bold" />

            <!-- Wide only: beside the title. -->
            <TextView
                android:id="@+id/seeAllSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/content_muted"
                android:textSize="13sp"
                tools:text="Taverna · 12 games" />

            <!-- Compact only: what pushes the buttons to the end in the subtitle's place. -->
            <Space
                android:id="@+id/seeAllToolbarSpace"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/seeAllSearch"
                style="@style/HeaderAction"
                android:contentDescription="@string/nav_search"
                android:src="@drawable/ic_search"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/seeAllSortIcon"
                style="@style/HeaderAction"
                android:layout_marginEnd="@dimen/see_all_back_offset"
                android:src="@drawable/ic_sort"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/seeAllSort"
                style="@style/Widget.Zefiro.HeaderChip"
                android:layout_marginStart="@dimen/pc_card_spacing"
                app:icon="@drawable/ic_expand_more"
                app:iconGravity="end"
                tools:text="Recently played" />

        </LinearLayout>

        <!-- Compact only: under the toolbar, where it never truncates the count. -->
        <TextView
            android:id="@+id/seeAllSubtitleLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/content_muted"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Taverna · 12 games · Recently played" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/seeAllGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/see_all_grid_padding"
            android:paddingEnd="@dimen/see_all_grid_padding"
            android:paddingBottom="@dimen/section_gutter"
            android:scrollbars="none" />

        <include layout="@layout/view_host_state_panel" />

    </FrameLayout>

</LinearLayout>
