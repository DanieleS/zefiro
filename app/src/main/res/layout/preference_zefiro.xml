<?xml version="1.0" encoding="utf-8"?>
<!--
    A settings row in the app's own grammar rather than Material's. The stock row sets
    title and summary at nearly the same weight, so a screen of them reads as a wall of
    prose; here they sit two steps apart on the prominence ladder — the title in
    content_primary, the explanation muted and a size down — and the row keeps the same
    gutter as the category header above it so the column has one edge.

    The ids are the framework's (@android:id/title, summary, icon, widget_frame): androidx
    binds them by id, and the widget frame is where a switch or a seek bar is inflated.

    The rest is bound by SettingsAdapter on the stream settings list, and stays gone anywhere
    else this row is used: a dot before the title when the value is not its default, the value
    itself on the right in mono, and an icon on a row that opens a web page. The row is a stop
    (stop_bg), inset by 8dp so its focus ring has room; the inset plus the padding keeps the
    text on the settings gutter the category headers use.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/settings_row_inset"
    android:layout_marginEnd="@dimen/settings_row_inset"
    android:background="@drawable/stop_bg"
    android:baselineAligned="false"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/settings_row_padding"
    android:paddingEnd="@dimen/settings_row_padding"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/icon_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:minWidth="40dp"
        android:orientation="horizontal"
        android:paddingEnd="12dp">

        <androidx.preference.internal.PreferenceImageView
            android:id="@android:id/icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="24dp"
            android:maxHeight="24dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/settingChangedDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/settings_changed_dot"
                android:contentDescription="@string/settings_changed"
                android:visibility="gone" />

            <TextView
                android:id="@android:id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Zefiro.PreferenceTitle" />

        </LinearLayout>

        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textAppearance="@style/TextAppearance.Zefiro.PreferenceSummary" />

    </LinearLayout>

    <!-- What the row is set to; a switch row shows its switch instead. -->
    <TextView
        android:id="@+id/settingValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:maxWidth="@dimen/settings_value_max_width"
        android:singleLine="true"
        android:textColor="@color/settings_value"
        android:textSize="13sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/settingExternal"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="12dp"
        android:contentDescription="@string/settings_opens_in_browser"
        android:src="@drawable/ic_open_in_new"
        android:visibility="gone"
        android:tint="@color/content_muted" />

    <!-- The switch, seek bar or other control. Nothing of ours goes here. -->
    <LinearLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="vertical"
        android:paddingStart="12dp" />

</LinearLayout>
