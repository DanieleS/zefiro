<?xml version="1.0" encoding="utf-8"?>
<!--
    The Settings section's header, after Settings_C: the search field, the pinned card, the jump
    chips. One instance, bound by SettingsHeader; SettingsSectionFragment hangs it above the list
    on the Thor, and makes it the list's first item on an upright phone, where it scrolls away as
    the phone mock does. On a turned phone it stays above the list but for the card, which is
    the list's first item and scrolls away alone (SettingsHeader.hangCard). The sticky label of the section in view is the
    section's own (fragment_settings), so it stays when the header scrolls away.

    Searching, the same header turns into the search bar (back, the query, clear), the chips into
    the results' filters, and the card goes.

    Which parts a window shows (SettingsHeader.setWide):
      wide     the profile as the card's first pin, "{n} changed" (hidden at none)
      compact  the profile as a row with Switch above five value pills, no Pinned chip (the
               card is right above the chips)

    Either way, while a gamepad is connected (SettingsHeader.setGlyphs), the Y glyph on the
    field and L1 / R1 around the chips, and B in place of the search's back arrow.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_deep"
    android:orientation="vertical"
    android:paddingStart="@dimen/section_gutter"
    android:paddingTop="@dimen/section_header_padding_top"
    android:paddingEnd="@dimen/section_gutter"
    android:paddingBottom="2dp">

    <!-- At rest: the field is a button that starts a search, as the mocks draw it. -->
    <LinearLayout
        android:id="@+id/settingsSearchRest"
        android:layout_width="match_parent"
        android:layout_height="@dimen/action_size"
        android:background="@drawable/search_field_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/search_field_padding"
        android:paddingEnd="@dimen/search_field_padding">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search"
            app:tint="@color/content_muted" />

        <TextView
            android:id="@+id/settingsSearchHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/content_muted"
            android:textSize="15sp" />

        <include
            android:id="@+id/settingsSearchGlyph"
            layout="@layout/view_gamepad_hint_key" />

    </LinearLayout>

    <!-- Searching: back, the query, clear. -->
    <LinearLayout
        android:id="@+id/settingsSearchBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/action_size"
        android:background="@drawable/search_field_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/settingsSearchBack"
            android:layout_width="@dimen/action_size"
            android:layout_height="@dimen/action_size"
            android:background="@drawable/stop_bg"
            android:contentDescription="@string/settings_search_back"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/content_secondary" />

        <EditText
            android:id="@+id/settingsSearchField"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/stop_bg"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:hint="@string/settings_search_field_hint"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:textColor="@color/content_primary"
            android:textColorHint="@color/content_muted"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/settingsSearchClear"
            android:layout_width="@dimen/action_size"
            android:layout_height="@dimen/action_size"
            android:background="@drawable/stop_bg"
            android:contentDescription="@string/settings_search_clear"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            android:visibility="invisible"
            app:tint="@color/content_secondary" />

    </LinearLayout>

    <!-- The pinned card. -->
    <LinearLayout
        android:id="@+id/settingsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/settings_header_gap"
        android:background="@drawable/settings_card_bg"
        android:orientation="vertical">

        <!-- Compact: the profile as a row, with Switch. -->
        <LinearLayout
            android:id="@+id/settingsProfileRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <FrameLayout
                android:layout_width="@dimen/settings_profile_icon_size"
                android:layout_height="@dimen/settings_profile_icon_size"
                android:background="@drawable/settings_profile_icon_bg">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_profiles"
                    app:tint="@color/signal" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/settingsProfileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:textColor="@color/content_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/settingsProfileSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/content_muted"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/settingsProfileSwitch"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/action_size"
                android:layout_marginStart="8dp"
                android:background="@drawable/chip_bg"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:text="@string/settings_profile_switch"
                android:textColor="@color/chip_text"
                android:textSize="14sp" />

        </LinearLayout>

        <View
            android:id="@+id/settingsCardRule"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/settings_card_rule" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Wide: the profile as the card's first pin. -->
            <LinearLayout
                android:id="@+id/settingsProfilePin"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/settings_pin_height"
                android:background="@drawable/stop_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <FrameLayout
                    android:layout_width="@dimen/settings_profile_icon_size_small"
                    android:layout_height="@dimen/settings_profile_icon_size_small"
                    android:background="@drawable/settings_profile_icon_bg">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_profiles"
                        app:tint="@color/signal" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.12"
                        android:singleLine="true"
                        android:text="@string/settings_pin_profile"
                        android:textAllCaps="true"
                        android:textColor="@color/content_muted"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/settingsProfilePinName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxWidth="140dp"
                        android:singleLine="true"
                        android:textColor="@color/content_primary"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- The values: five share the width, and more scroll. -->
            <HorizontalScrollView
                android:id="@+id/settingsPinsScroll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/settingsPins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

        </LinearLayout>

    </LinearLayout>

    <!-- The chips: jumps at rest, filters while searching. -->
    <LinearLayout
        android:id="@+id/settingsChipsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <include
            android:id="@+id/settingsChipsPrevGlyph"
            layout="@layout/view_gamepad_hint_key" />

        <HorizontalScrollView
            android:id="@+id/settingsChipsScroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:fadingEdgeLength="24dp"
            android:requiresFadingEdge="horizontal"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/settingsChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <!-- Apart from the row, so a chip cut by the scroll's end does not read as under it. -->
        <include
            android:id="@+id/settingsChipsNextGlyph"
            layout="@layout/view_gamepad_hint_key"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/key_glyph_height"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/settingsChangedChip"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/action_size"
            android:layout_marginStart="8dp"
            android:background="@drawable/stop_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="@color/content_muted"
            android:textSize="13sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/settingsAlsoMatches"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="@color/content_muted"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
