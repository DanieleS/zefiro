<?xml version="1.0" encoding="utf-8"?>
<!--
    One value on the Settings pinned card in a wide window, after the Thor mock's .pin: a quiet
    label over the value in mono, a stop of 56dp. A or a tap goes to the setting's row; nothing
    is changed on the card. "profile" beside the label says the active profile sets the value
    shown, in place of the stored one. Built by SettingsHeader, which sizes it to share the card.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/settings_pin_height"
    android:background="@drawable/stop_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minWidth="@dimen/settings_pin_min_width"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/settingPinLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:letterSpacing="0.12"
            android:maxWidth="160dp"
            android:singleLine="true"
            android:textAllCaps="true"
            android:textColor="@color/content_muted"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="Resolution" />

        <TextView
            android:id="@+id/settingPinTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/stats_chip_bg"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:singleLine="true"
            android:text="@string/settings_pin_profile_tag"
            android:textColor="@color/signal"
            android:textSize="9sp"
            android:visibility="gone" />

    </LinearLayout>

    <TextView
        android:id="@+id/settingPinValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:maxWidth="200dp"
        android:singleLine="true"
        android:textColor="@color/content_primary"
        android:textSize="14sp"
        tools:text="1080p" />

</LinearLayout>
