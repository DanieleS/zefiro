<?xml version="1.0" encoding="utf-8"?>
<!--
    A menu risen from the bottom edge (ui/MenuSheet.showBottom), for a compact window where a
    thumb is near the edge: the sheet's drag handle over the same panel the centred menu shows,
    whose rows are put in @id/menuSheetBottomBody in code. The handle is for touch; the d-pad
    starts on the first row and never stops on it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:id="@+id/menuSheetHandle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="false" />

    <FrameLayout
        android:id="@+id/menuSheetBottomBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
