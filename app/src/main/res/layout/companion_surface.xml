<?xml version="1.0" encoding="utf-8"?>
<!--
    The companion surface. Exactly one of its surfaces is visible at a time: the browsing
    surface (or, with nothing to browse, the app name), the stats dashboard, or a game's
    telemetry view while streaming.

    The window never takes key focus (see CompanionPresentation), so every control drawn here
    is a touch target, at 48dp, and none of them is focusable.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_deep">

    <!-- The browsed game's background/hero art, or the art of the game a browsed host is
         running. Behind everything; a scrim keeps the text on top of it legible. Both are
         toggled from code. -->
    <ImageView
        android:id="@+id/companionBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/companionBackdropScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/backdrop_scrim"
        android:visibility="gone" />

    <!--
        Browsing surface, after the approved Shelves and See all mocks' bottom screen: what the
        main screen is on, read from the top left. For a game, a "Focused" label, its name, a
        meta line (year · genres · score) and its description, then Play (or Resume and Quit
        game while it runs) at the foot; for a host, its name and state. With nothing to show it
        falls back to the app name, centred, so it is never empty. The hosts row sits at the
        bottom of it all while browsing.
    -->
    <LinearLayout
        android:id="@+id/companionIdle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Its gravity is set from code: top-start over a game or host, centred when idle. -->
        <LinearLayout
            android:id="@+id/companionIdleColumn"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="@dimen/companion_padding"
            android:paddingTop="@dimen/companion_padding"
            android:paddingEnd="@dimen/companion_padding"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/companionIdleLabel"
                style="@style/CompanionSectionLabel"
                android:layout_marginBottom="10dp"
                android:text="@string/companion_focused"
                android:visibility="gone" />

            <TextView
                android:id="@+id/companionIdleTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="@string/app_label"
                android:textColor="@color/content_primary"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/companionIdleMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/content_secondary"
                android:textSize="17sp"
                android:visibility="gone" />

            <!--
                The description is as long as the host makes it, so it scrolls rather than
                truncating. It takes the space the title, meta line and actions leave it, and
                scrolls beyond that; without one, the spacer below takes that space instead. The
                fading edge is what tells the reader there is more below.
            -->
            <ScrollView
                android:id="@+id/companionIdleDescriptionScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="16dp"
                android:scrollbars="vertical"
                android:scrollbarThumbVertical="@color/divider"
                android:requiresFadingEdge="vertical"
                android:fadingEdgeLength="28dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/companionIdleDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="@color/content_muted"
                    android:textSize="16sp" />

            </ScrollView>

            <!-- Pushes the actions to the foot of the column when there is no description. -->
            <Space
                android:id="@+id/companionIdleSpacer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:visibility="gone" />

            <!--
                The browsed game's actions: Play, across the column, or Resume and Quit game for
                the one the host is running. Pills after the hero's (item_continue_hero), drawn
                without MaterialButton because this panel is hosted on every activity, including
                ones whose theme is not a Material one.
            -->
            <LinearLayout
                android:id="@+id/companionActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/companionPlay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/companion_play_height"
                    android:background="@drawable/companion_primary_bg"
                    android:clickable="true"
                    android:focusable="false"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="22dp"
                    android:paddingEnd="26dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_resume"
                        android:tint="@color/on_signal" />

                    <TextView
                        android:id="@+id/companionPlayLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/companion_play"
                        android:textColor="@color/on_signal"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02" />

                </LinearLayout>

                <TextView
                    android:id="@+id/companionQuit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:minHeight="@dimen/companion_play_height"
                    android:background="@drawable/companion_ghost_bg"
                    android:clickable="true"
                    android:focusable="false"
                    android:gravity="center"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:singleLine="true"
                    android:text="@string/library_quit_game"
                    android:textColor="@color/content_primary"
                    android:textSize="17sp"
                    android:letterSpacing="0.02"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

        <!--
            The hosts row: every known PC as a compact chip (item_companion_host), the selected
            one in the signal, under a "Hosts" label. A tap selects that PC on the main screen.
            It scrolls sideways when there are more PCs than fit, and is gone when not browsing.
        -->
        <LinearLayout
            android:id="@+id/companionHosts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/companion_padding"
            android:visibility="gone">

            <TextView
                style="@style/CompanionSectionLabel"
                android:layout_marginStart="@dimen/companion_padding"
                android:layout_marginBottom="10dp"
                android:text="@string/companion_hosts" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:fillViewport="false"
                android:paddingStart="@dimen/companion_padding"
                android:paddingEnd="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/companionHostItems"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/companionStats"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="20dp">

        <!-- Hero: what is being streamed, and how fast. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/companion_label_stream"
                    android:textColor="@color/content_muted"
                    android:textSize="10sp"
                    android:letterSpacing="0.16"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/companionResolution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/content_primary"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/companionFps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/signal"
                    android:textSize="44sp"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/companion_label_fps"
                    android:textColor="@color/content_muted"
                    android:textSize="11sp"
                    android:letterSpacing="0.16"
                    android:textAllCaps="true"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@color/divider" />

        <!-- The four numbers worth watching mid-game. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/CompanionTileLabel"
                    android:text="@string/companion_label_latency" />

                <TextView
                    android:id="@+id/companionLatency"
                    style="@style/CompanionTileValue" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/CompanionTileLabel"
                    android:text="@string/companion_label_decode" />

                <TextView
                    android:id="@+id/companionDecodeTime"
                    style="@style/CompanionTileValue" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/CompanionTileLabel"
                    android:text="@string/companion_label_loss" />

                <TextView
                    android:id="@+id/companionLoss"
                    style="@style/CompanionTileValue" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/CompanionTileLabel"
                    android:text="@string/companion_label_bandwidth" />

                <TextView
                    android:id="@+id/companionBandwidth"
                    style="@style/CompanionTileValue" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="14dp"
            android:background="@color/divider" />

        <!-- Detail, for when something above looks wrong. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/CompanionDetailLabel"
                android:text="@string/companion_label_frames" />

            <TextView
                android:id="@+id/companionFrames"
                style="@style/CompanionDetailValue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/companionHostRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                style="@style/CompanionDetailLabel"
                android:text="@string/companion_label_host" />

            <TextView
                android:id="@+id/companionHostLatency"
                style="@style/CompanionDetailValue" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                style="@style/CompanionDetailLabel"
                android:text="@string/companion_label_decoder" />

            <TextView
                android:id="@+id/companionDecoder"
                style="@style/CompanionDetailValue"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

    </LinearLayout>

    <!--
        A game's telemetry view, and beneath it a strip the panel keeps for itself. Sits above the
        stats because when a game has a view, that view is what the panel is for; the stats are
        what it falls back to. Shown only while a view is on screen.

        The strip is what keeps the menu button off the view. A view may be interactive, and it is
        written without knowing where the panel puts its controls, so the only placement that holds
        for every view is one the view never covers: the WebView gets the space above the strip and
        nothing else. The strip carries a quiet line of stream stats so it is not dead space.
    -->
    <LinearLayout
        android:id="@+id/companionTelemetry"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Empty unless a view is on screen: the WebView is created only when one is, since most
             surfaces never need it. Its content is a file installed on this device, rendered with
             no origin, no file access and no network - see CompanionPresentation. -->
        <FrameLayout
            android:id="@+id/companionTelemetryContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/companionTelemetryStats"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/content_faint"
                android:textSize="12sp" />

            <!-- Just the glyph, in the stats' own grey: a floating disc belongs over content, and
                 here there is none to float over. The touch target stays 40dp; with the 10dp
                 end padding the glyph ends 20dp from the edge, mirroring the stats' start. -->
            <ImageButton
                android:id="@+id/companionTelemetryMenuButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/menu_button"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_menu"
                android:tint="@color/content_faint" />
        </LinearLayout>
    </LinearLayout>

    <!-- Opens the in-game menu here on the panel. Only out while a game is streaming; the
         idle library surface has no menu to raise. Kept at the bottom so it clears the stats
         header, whose FPS readout owns the top-right corner. -->
    <ImageButton
        android:id="@+id/companionMenuButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:background="@drawable/floating_menu_button"
        android:contentDescription="@string/menu_button"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_menu"
        android:visibility="gone" />

    <!-- The keyboard raised when the host reports a focused text field. Above the panel's
         content, below the menu so the menu still opens over it. Empty until it is needed. -->
    <FrameLayout
        android:id="@+id/companionKeyboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
        The in-game menu, drawn here so the game on the main screen stays whole while it is
        open. The rows are navigated by the gamepad, routed over from the Game activity, and
        the selected one is marked activated since this window holds no input focus of its own.
    -->
    <FrameLayout
        android:id="@+id/companionMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:clickable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:background="@drawable/menu_sheet_bg"
            android:orientation="vertical"
            android:paddingStart="@dimen/menu_sheet_padding"
            android:paddingEnd="@dimen/menu_sheet_padding"
            android:paddingTop="16dp"
            android:paddingBottom="@dimen/menu_sheet_padding">

            <TextView
                android:id="@+id/companionMenuTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                android:ellipsize="end"
                android:letterSpacing="0.16"
                android:singleLine="true"
                android:textAllCaps="true"
                android:textColor="@color/content_muted"
                android:textSize="13sp" />

            <com.limelight.ui.MaxHeightScrollView
                android:id="@+id/companionMenuScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/companionMenuItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </com.limelight.ui.MaxHeightScrollView>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
