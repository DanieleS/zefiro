<?xml version="1.0" encoding="utf-8"?>
<!--
    One action in a menu. A row that takes the signal ring on focus and fills on a press,
    the same as a tile. The icon and the check are optional and start gone; the label
    carries the weight.

    A row can also carry a status dot before its label and one action of its own after it
    (the host sheet: a PC's state, and Wake on an offline one). The trailing action is a
    separate stop, RIGHT of the row (MenuSheet walks the d-pad between the two by hand), so
    the row's own press still does the row's thing.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="2dp"
    android:background="@drawable/menu_row_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/menu_row_min_height"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/menuRowIcon"
        android:layout_width="@dimen/menu_row_icon"
        android:layout_height="@dimen/menu_row_icon"
        android:layout_marginEnd="16dp"
        android:tint="@color/content_secondary"
        android:visibility="gone" />

    <View
        android:id="@+id/menuRowDot"
        android:layout_width="@dimen/pc_status_dot"
        android:layout_height="@dimen/pc_status_dot"
        android:layout_marginEnd="14dp"
        android:background="@drawable/pc_status_dot"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <TextView
        android:id="@+id/menuRowLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/content_primary"
        android:textSize="16sp" />

    <!-- A plain TextView on the chip's drawable rather than a MaterialButton: menus are also
         raised from the stream, whose theme is not a Material one. -->
    <TextView
        android:id="@+id/menuRowTrailing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:background="@drawable/host_chip_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="@dimen/action_size"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:singleLine="true"
        android:textColor="@color/content_primary"
        android:textSize="14sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/menuRowCheck"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="12dp"
        android:src="@drawable/ic_check"
        android:tint="@color/signal"
        android:visibility="gone" />

</LinearLayout>
