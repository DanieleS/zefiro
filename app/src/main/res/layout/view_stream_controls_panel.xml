<?xml version="1.0" encoding="utf-8"?>
<!--
    The in-stream side panel's skeleton, merged into StreamControlsPanel: a scrim over the game
    whose tap closes the panel, and the panel itself on the right edge, after the approved
    Stream mock. The header (game, PC, session, the stream's numbers) stays put; the page under
    it is rebuilt for each page of the controls, and the session's two ends sit at the bottom of
    the first page only.

    Plain views throughout: the stream's theme is not a Material one.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <View
        android:id="@+id/controlsScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/controls_scrim"
        android:clickable="true"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <!-- Width is set in code from the window (StreamControlsPanel#applyWidth). Clickable so a
         tap on the panel's own ground never falls through to the scrim and closes it. -->
    <com.limelight.ui.FocusTrapLayout
        android:id="@+id/controlsSheet"
        android:layout_width="@dimen/controls_panel_max_width"
        android:layout_height="match_parent"
        android:layout_gravity="right"
        android:background="@drawable/controls_panel_bg"
        android:clickable="true"
        android:focusable="false"
        android:paddingLeft="@dimen/controls_panel_padding"
        android:paddingTop="12dp"
        android:paddingRight="@dimen/controls_panel_padding"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/controlsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/content_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/controlsSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/content_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/controlsStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:textColor="@color/content_secondary"
            android:textSize="11sp"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/controlsScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/controlsPage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/controlsDanger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />

    </com.limelight.ui.FocusTrapLayout>

</merge>
