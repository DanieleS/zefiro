<?xml version="1.0" encoding="utf-8"?>
<!-- The glyph in a PC tile's icon box, and the Add PC tile's plus: the signal on a focused tile. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:color="@color/signal" />
    <item android:state_focused="true" android:color="@color/signal" />
    <item android:state_activated="true" android:color="@color/signal" />
    <item android:color="@color/content_secondary" />
</selector>
