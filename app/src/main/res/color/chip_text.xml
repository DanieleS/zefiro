<?xml version="1.0" encoding="utf-8"?>
<!-- A chip's label: the signal on a selected chip, dimmed on a disabled one, as in the mocks. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/outline" android:state_enabled="false" />
    <item android:color="@color/signal" android:state_selected="true" />
    <item android:color="@color/content_primary" />
</selector>
